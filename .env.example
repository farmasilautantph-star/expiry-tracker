# Expiry Tracker — Environment Variables
# Copy this file to .env.local and fill in values

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this

# Email (Nodemailer + Gmail SMTP)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# App
NEXT_PUBLIC_APP_NAME=Expiry Tracker
NODE_ENV=development

# DB (auto-created at this path)
DB_PATH=./db/expiry-tracker.db

# Vercel Cron auth — generate a random 32+ char hex string
# (e.g. `openssl rand -hex 32`). Must match the value in Vercel env vars.
CRON_SECRET=
