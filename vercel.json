{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/lock-expiring",
      "schedule": "0 1 * * *"
    }
  ]
}
